# Internal state database (change all secrets outside disposable local development)
SENTINEL_DB_PASSWORD=replace-with-a-long-random-password

# Operational API token; there is intentionally no application default.
API_TOKEN=replace-with-a-long-random-token
UI_ADMIN_PASSWORD=replace-with-a-separate-ui-password
# The MCP endpoint accepts localhost by default. For a remote deployment, use JSON arrays:
# MCP_ALLOWED_HOSTS=["sentinel.example.com"]
# MCP_ALLOWED_ORIGINS=["https://agent.example.com"]

# Local disposable PostgreSQL bootstrapping credentials. The API and worker never receive the
# admin password. Both application target roles below have default_transaction_read_only=on.
TARGET_MONITOR_PASSWORD=replace-with-a-long-random-password
TARGET_ADMIN_PASSWORD=replace-with-a-separate-demo-only-password
DEMO_WORKLOAD_PASSWORD=replace-with-a-read-only-demo-password
# PostgreSQL log threshold for finding client names (set to -1 to disable duration logging).
# POSTGRES_LOG_MIN_DURATION_STATEMENT=1s

# Optional AI investigation. Deterministic detection works without a provider key.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
AI_MODEL=openai:gpt-5-mini

# Optional notification endpoint.
WEBHOOK_URL=
LOG_LEVEL=INFO
